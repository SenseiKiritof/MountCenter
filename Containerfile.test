FROM fedora:44

RUN dnf -y install \
        python3 \
        python3-gobject \
        gobject-introspection \
        gtk4 \
        libadwaita \
        util-linux \
        systemd \
        xorg-x11-server-Xvfb \
        dbus-daemon \
    && dnf clean all

ENV GSETTINGS_BACKEND=memory
WORKDIR /src

CMD ["python3", "-m", "unittest", "discover", "-s", "tests", "-v"]
